{
  "name": "Worker 2 - Cambio de opinión",
  "nodes": [
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "={\n  \"type\": \"object\",\n  \"required\": [\n    \"intencion_cliente\",\n    \"motivo\",\n    \"turno_encontrado\",\n    \"borrador_correo\"\n  ],\n  \"properties\": {\n    \"intencion_cliente\": {\n      \"type\": \"string\",\n      \"enum\": [\"cancelar\", \"reprogramar\", \"otro\"],\n      \"description\": \"Indica si el cliente opta por cancelar o si está pidiendo otra opción de turno.\"\n    },\n    \"motivo\": {\n      \"type\": \"string\",\n      \"description\": \"Breve explicación basada en la respuesta del cliente.\"\n    },\n    \"turno_encontrado\": {\n      \"type\": \"object\",\n      \"required\": [\"fecha\", \"hora\"],\n      \"properties\": {\n        \"fecha\": {\n          \"type\": [\"string\", \"null\"],\n          \"description\": \"Fecha en formato YYYY-MM-DD o null si canceló.\"\n        },\n        \"hora\": {\n          \"type\": [\"string\", \"null\"],\n          \"description\": \"Hora en formato HH:MM o null si canceló.\"\n        }\n      }\n    },\n    \"borrador_correo\": {\n      \"type\": \"object\",\n      \"required\": [\"asunto\", \"cuerpo\"],\n      \"properties\": {\n        \"asunto\": {\n          \"type\": \"string\",\n          \"description\": \"Asunto correspondiente al correo.\"\n        },\n        \"cuerpo\": {\n          \"type\": \"string\",\n          \"description\": \"Texto completo del correo redactado y listo para que el taller lo envíe.\"\n        }\n      }\n    }\n  }\n}"
      },
